# Configurazione del job di pubblicazione (si copia in ~/CosmicHorrorPubblica/pubblica.conf; si legge a ogni giro, non serve riavviare nulla).
# Una riga per chiave, formato chiave=valore. Il token NON va qui: sta nel Portachiavi di macOS.

# Indirizzo SSH del repository (usa la deploy key in sola lettura)
REPO_URL=git@github.com:servisys/cosmic-horror.git

# File della chiave privata della deploy key
CHIAVE=~/.ssh/cosmic_horror_deploy

# main = pubblica ogni nuovo commit di main; versioni = pubblica solo quando c'e' un nuovo tag v* (per esempio v0.2.0)
MODALITA=main

# Nome dell'elemento nel Portachiavi (di norma non si cambia)
SERVIZIO_PORTACHIAVI=cosmic-horror-swa
